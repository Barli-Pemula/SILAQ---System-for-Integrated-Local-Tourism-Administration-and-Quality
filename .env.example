# Vercel: install Neon / another PostgreSQL provider from Marketplace.
# Use its POOLED connection URL, including the provider's SSL options.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=https://your-project.vercel.app

# sandbox | production | demo (demo requires explicit ALLOW_DEMO_PAYMENTS=true)
PAYMENT_MODE=sandbox
MIDTRANS_SERVER_KEY=
ALLOW_DEMO_PAYMENTS=false

# Optional server override of the public Gilang template password, only in demo mode.
# The login form always starts with the public demo template. Accounts must exist in the database.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_PASSWORD=

# Keep false until sample catalog is replaced with contracted partner inventory.
CATALOG_APPROVED=false

# Local development only; Vercel always rejects the local database adapter.
LOCAL_DATABASE=false
LOCAL_DATABASE_PATH=.data/postgres

# One-time provisioning: run `npm run setup` with these configured, then remove password.
PROVISION_EMAIL=
PROVISION_PASSWORD=
PROVISION_NAME=Pengelola SILAQ
PROVISION_ROLE=superadmin
# For role=admin, assign individual product IDs, for example:
PROVISION_PRODUCTS=dest-gili,boat-gili
